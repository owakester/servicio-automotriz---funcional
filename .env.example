# OAuth 2.0 Client ID de tipo "Web application".
# No agregues un Client Secret: esta aplicación se ejecuta en el navegador.
VITE_GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com

# Cuenta del taller. Es una sugerencia de inicio de sesión y una restricción
# comprobada antes de permitir operaciones en Drive. Requiere autorización OAuth.
VITE_GOOGLE_DRIVE_EMAIL=
